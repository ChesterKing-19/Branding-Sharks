/* ============================================================
   Services — capability diagram
   Section + panel geometry lives in app/globals.css so the
   dynamic() loading skeleton is styled before this chunk loads.

   Portrait (<840px): stacked flow — service cluster on top, logo hub
   centred, outcome chips along the bottom. Arrows run vertically.
   Landscape (>=840px): absolute composition — cluster left, hub centre,
   outcomes fanned right. Arrows run horizontally.

   `--hub-zoom` is the intro scale the logo starts at before it shrinks
   into the hub. Read once per breakpoint by ServicesDiagram.
   ============================================================ */

.services-diagram {
  --hub-zoom: 2.1;
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: clamp(8px, 2.4vw, 18px);
  padding: clamp(12px, 3.4vw, 22px);
  isolation: isolate;
}

/* Faint dot grid, faded out toward the panel edges. */
.services-diagram__grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: radial-gradient(
    rgba(255, 255, 255, 0.05) 1px,
    transparent 1px
  );
  background-size: 26px 26px;
  -webkit-mask-image: radial-gradient(
    ellipse 72% 72% at 50% 50%,
    #000 15%,
    transparent 78%
  );
  mask-image: radial-gradient(
    ellipse 72% 72% at 50% 50%,
    #000 15%,
    transparent 78%
  );
}

/* Wide horizontal lime band behind the hub, not a circular radial. */
.services-diagram__glow {
  position: absolute;
  inset: -10% -6%;
  pointer-events: none;
  filter: blur(18px);
  background:
    radial-gradient(
      ellipse 40% 46% at 50% 50%,
      rgba(168, 200, 20, 0.22),
      rgba(168, 200, 20, 0.08) 42%,
      transparent 70%
    ),
    radial-gradient(
      ellipse 58% 26% at 50% 50%,
      rgba(168, 200, 20, 0.16),
      transparent 72%
    );
}

.services-diagram__glow-core {
  position: absolute;
  inset: 20% 26%;
  background: radial-gradient(
    circle at center,
    rgba(168, 200, 20, 0.3),
    transparent 68%
  );
  filter: blur(24px);
}

/* ---- connector arrows ---- */
.services-diagram__arrows {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
  z-index: 1;
}

.services-diagram__arrow-line {
  fill: none;
  stroke: rgba(168, 200, 20, 0.68);
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 0;
  vector-effect: non-scaling-stroke;
}

.services-diagram__arrow-head {
  fill: var(--lime);
  stroke: none;
}

/* ---- service pills ---- */
.services-diagram__cluster {
  order: 1;
  position: relative;
  z-index: 2;
  list-style: none;
  margin: 0 auto;
  padding: 0;
  width: 100%;
  max-width: 460px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(5px, 1.4vw, 9px);
}

.services-diagram__service {
  display: flex;
  align-items: center;
  gap: clamp(6px, 1.6vw, 9px);
  height: clamp(32px, 9vw, 44px);
  padding: 0 clamp(6px, 1.8vw, 10px) 0 clamp(4px, 1vw, 6px);
  border-radius: 9px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  background: rgba(15, 17, 10, 0.9);
  color: #eef1e6;
  font-size: clamp(10px, 2.7vw, 13px);
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.4);
}

.services-diagram__service img {
  flex: 0 0 auto;
  width: clamp(18px, 5vw, 26px);
  height: clamp(18px, 5vw, 26px);
  border-radius: 5px;
  object-fit: cover;
  background: #000;
}

.services-diagram__service span {
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---- hub ---- */
.services-diagram__hub-anchor {
  order: 2;
  position: relative;
  z-index: 3;
  display: grid;
  place-items: center;
}

.services-diagram__hub {
  position: relative;
  display: grid;
  place-items: center;
  width: clamp(122px, 34vw, 196px);
  height: clamp(64px, 17.5vw, 100px);
  border-radius: 14px;
  transform-origin: 50% 50%;
  will-change: transform;
}

/* The card surface fades up while the zoomed logo shrinks into place. */
.services-diagram__hub-surface {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1px solid rgba(168, 200, 20, 0.24);
  background: linear-gradient(155deg, #14180c 0%, #090a06 100%);
  box-shadow:
    0 0 40px rgba(168, 200, 20, 0.18),
    inset 0 0 30px rgba(168, 200, 20, 0.06);
}

.services-diagram__hub img {
  position: relative;
  z-index: 1;
  width: 76%;
  height: auto;
  max-height: 68%;
  object-fit: contain;
}

/* ---- outcome pills ---- */
.services-diagram__outcomes {
  order: 3;
  position: relative;
  z-index: 2;
  list-style: none;
  margin: 0;
  padding: 0;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: clamp(3px, 1vw, 6px);
}

.services-diagram__outcome {
  display: flex;
  align-items: center;
  justify-content: center;
  height: clamp(26px, 6.8vw, 34px);
  padding: 0 clamp(2px, 1vw, 8px);
  border-radius: 999px;
  background: var(--lime);
  color: #10130a;
  font-size: clamp(8px, 2.35vw, 12px);
  font-weight: 700;
  letter-spacing: 0.005em;
  white-space: nowrap;
  box-shadow: 0 6px 18px rgba(168, 200, 20, 0.16);
}

/* ============================================================
   Landscape layout
   ============================================================ */
@media (min-width: 840px) {
  .services-diagram {
    --hub-zoom: 2.6;
    display: block;
    padding: 0;
  }

  .services-diagram__cluster {
    position: absolute;
    left: 2.6%;
    top: 0;
    bottom: 0;
    height: max-content;
    width: clamp(250px, 25vw, 372px);
    /* Layout centring, not translateY(-50%): ServicesDiagram measures the
       cluster with offset* metrics, which ignore transforms. */
    margin: auto 0;
    max-width: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(5, auto);
    gap: clamp(9px, 1vw, 15px) clamp(8px, 0.85vw, 12px);
  }

  .services-diagram__service {
    height: clamp(38px, 4vw, 62px);
    padding: 0 11px 0 5px;
    gap: clamp(7px, 0.7vw, 10px);
    font-size: clamp(11px, 0.9vw, 13px);
  }

  .services-diagram__service img {
    width: clamp(23px, 2.3vw, 34px);
    height: clamp(23px, 2.3vw, 34px);
    border-radius: 7px;
  }

  /* Ladder the second column so the cluster reads as a crafted shape. */
  .services-diagram__service:nth-child(n + 6) {
    margin-top: clamp(12px, 1.5vw, 24px);
  }

  .services-diagram__hub-anchor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .services-diagram__hub {
    width: clamp(170px, 18.6vw, 274px);
    height: clamp(90px, 9.8vw, 144px);
    border-radius: 18px;
    pointer-events: auto;
  }

  .services-diagram__outcomes {
    position: absolute;
    inset: 0;
    display: block;
  }

  .services-diagram__outcome {
    position: absolute;
    left: var(--ox, 70%);
    top: var(--oy, 50%);
    width: clamp(138px, 13.8vw, 200px);
    height: clamp(34px, 3.3vw, 47px);
    padding: 0;
    font-size: clamp(11px, 0.88vw, 13px);
  }

  .services-diagram__outcome:nth-child(1) {
    --ox: 67.5%;
    --oy: 13%;
  }

  .services-diagram__outcome:nth-child(2) {
    --ox: 71%;
    --oy: 28.5%;
  }

  .services-diagram__outcome:nth-child(3) {
    --ox: 73%;
    --oy: 44%;
  }

  .services-diagram__outcome:nth-child(4) {
    --ox: 71%;
    --oy: 59.5%;
  }

  .services-diagram__outcome:nth-child(5) {
    --ox: 67.5%;
    --oy: 75%;
  }

  .services-diagram__arrow-line {
    stroke-width: 3;
  }
}

/* Narrow landscape: keep a real arrow run between cluster and hub. */
@media (min-width: 840px) and (max-width: 979px) {
  .services-diagram__cluster {
    left: 1.6%;
    width: 236px;
  }

  .services-diagram__service {
    padding: 0 8px 0 5px;
    gap: 6px;
    font-size: 10.5px;
  }

  .services-diagram__service img {
    width: 22px;
    height: 22px;
  }

  .services-diagram__hub {
    width: 158px;
    height: 84px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .services-diagram__service,
  .services-diagram__outcome,
  .services-diagram__arrow-line,
  .services-diagram__arrow-head {
    opacity: 1 !important;
    transform: none !important;
    stroke-dashoffset: 0 !important;
  }
}
